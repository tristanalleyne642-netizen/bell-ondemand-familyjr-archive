  "platform": {
    "target": "linux-embedded-arris",
    "format": ["shared-object", "native-app-bundle", "usb-install-package"],
    "compatible_devices": ["arris-linux-embedded-box", "legacy-iptv-set-top-box"]
  },
  "archive": {
    "title": "Bell On Demand Family Jr Archive",
    "description": "Historical library of Family Jr. on-demand service versions, arranged by year and release snapshot.",
    "install_method": "usb",
    "entrypoint": "lib/bell_familyjr_loader.so"
  },
  "builds": [
    {
      "year": 2015,
      "name": "bell_familyjr_2015",
