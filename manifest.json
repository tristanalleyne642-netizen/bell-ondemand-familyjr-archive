      "metadata": "archive/2015/metadata.json",
      "catalog": "archive/2015/catalog.json"
    },
    {
      "year": 2016,
      "name": "bell_familyjr_2016",
      "library": "lib/bell_familyjr_2016.so",
      "metadata": "archive/2016/metadata.json",
      "catalog": "archive/2016/catalog.json"
    },
    {
      "year": 2017,
      "name": "bell_familyjr_2017",
      "library": "lib/bell_familyjr_2017.so",
      "metadata": "archive/2017/metadata.json",
      "catalog": "archive/2017/catalog.json"
    },
    {
      "year": 2018,
      "name": "bell_familyjr_2018",
      "library": "lib/bell_familyjr_2018.so",
      "metadata": "archive/2018/metadata.json",
      "catalog": "archive/2018/catalog.json"
    },
    {
      "year": 2019,
      "name": "bell_familyjr_2019",
      "library": "lib/bell_familyjr_2019.so",
